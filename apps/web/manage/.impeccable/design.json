  "narrative": {
    "northStar": "现有后台的纸色工作台",
    "overview": "本说明只约束 `apps/web/manage` 的管理扩展。页面继承现有后台的纸色、墨色、青色、表格与表单，优先支持扫描、编辑和确认操作；不建立新的品牌或替代整个站点的视觉规范。\n\n样式真源是 `../app/app.css` 和 `../app/features/admin/ui.tsx`。`manage.css` 直接导入共享样式并声明共享后台组件的扫描路径，行业切换与离开确认复用这些语义 token。业务与权限边界见本目录 `PRODUCT.md`。",
    "keyCharacteristics": [
      "纸色页面与白色细边框面板。",
      "墨色主操作和选中态，青色链接与焦点。",
      "系统字体、紧凑信息层级、等宽配置数据。",
      "两行业共享组件与视觉语法，当前行业始终明确。"
    ],
    "rules": [
      {
        "name": "The Action Contrast Rule",
        "body": "主按钮、行业选中态和筛选选中态使用墨色底与纸色字；青色用于链接、焦点和轻量状态，不为两行业另配主题颜色。",
        "section": "colors"
      },
      {
        "name": "The One UI Voice Rule",
        "body": "管理扩展沿用共享系统字体与字重层级；等宽字体只承载标识和结构化数据。",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "常规面板保持平面分区；遮罩和浮层深度只用于需要停下并确认的交互。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 从共享样式和后台组件继承 token 与状态，不在管理扩展复制主题。",
      "Do 保持墨色选中态、青色链接与焦点，以及文字表达的状态含义。",
      "Do 让窄屏字段堆叠、操作换行、表格在自身容器中滚动。"
    ],
    "donts": [
      "Don't 为医疗和 AI 添加不同视觉世界或额外行业配色。",
      "Don't 把确认弹窗的遮罩、模糊或阴影推广到常规面板。",
      "Don't 把本目录的管理页面布局当作全站产品或视觉规范。"
    ]
  }
}
