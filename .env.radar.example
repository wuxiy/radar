# Copy to .env. Use random hex values for passwords and signing secrets; do not commit .env.
SITE_URL=http://localhost:3000
PORT=3000
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=
POSTGRES_PASSWORD=

# Native startup requires two explicit, different databases. Compose supplies these automatically.
# Existing AI data can be retained by pointing RADAR_AI_DATABASE_URL at its database.
# RADAR_AI_DATABASE_URL=postgres://radar:encoded-password@127.0.0.1:5432/radar_ai
# RADAR_MEDICAL_DATABASE_URL=postgres://radar:encoded-password@127.0.0.1:5432/radar_medical

COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false

# Common settings can be overridden per industry with RADAR_AI_ or RADAR_MEDICAL_.
# RADAR_AI_LLM_BASE_URL=https://your-provider/v1
# RADAR_AI_LLM_API_KEY=
# RADAR_MEDICAL_LLM_BASE_URL=https://your-provider/v1
# RADAR_MEDICAL_LLM_API_KEY=
# Or keep LLM_API_KEY in <medical-credential-dir>/models.env, backend reads only:
# RADAR_MEDICAL_AIHOT_CREDENTIALS_DIR=/private/medical-credentials
# RADAR_MEDICAL_LLM_MODEL=
# Optional: pin only default-model connections to an IP, retaining the URL Host and TLS checks.
# RADAR_MEDICAL_LLM_CONNECT_IP=
# RADAR_MEDICAL_INGEST_TOKEN=
# RADAR_AI_COLLECT_ENABLED=false
# RADAR_MEDICAL_COLLECT_ENABLED=false
# RADAR_AI_MODEL_CALLS_ENABLED=false
# RADAR_MEDICAL_MODEL_CALLS_ENABLED=false

# Optional native OIDC: keep these in each industry's private auth.env (mode 600).
# All five identity/mapping fields are required together; SITE_URL must be the public HTTPS origin.
# OIDC_ISSUER=https://auth.example.com/application/o/radar/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ADMIN_SUBJECT=
# OIDC_ADMIN_USER_ID=  # Existing admin_users.id in this industry's database
# OIDC_CA_FILE=       # Optional app-scoped CA for the identity center
# OIDC_LOOPBACK=false # NAS internal TLS: true requires OIDC_CA_FILE; Host/SNI remain the issuer host
